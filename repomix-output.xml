            [{'id': 'x', 'kind': rules.ENUM, 'tool': 'cancel_pending_order', 'argument': 'reason'}],
            [{'id': 'x', 'kind': rules.FORBIDDEN, 'tools': []}],
            [{'id': 'x', 'kind': rules.FORBIDDEN, 'tools': ['calculate']}] * 2,
