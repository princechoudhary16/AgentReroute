        self.assertEqual(parse_verdict('```json\n{"verdict":"pass","score":0.8}\n```')[:2], ('PASS', 0.8))
        self.assertEqual(parse_verdict('nonsense')[:2], ('FAIL', 0.0))
        self.assertEqual(parse_verdict('{"verdict":"PASS","score":"x"}')[:2], ('PASS', 0.0))


