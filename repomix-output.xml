        self.assertEqual(r['summary']['all']['rollback_exact'], 1.0)
        r = self.run_cli('eval-decisions', '--oracle', '--cases', CASES, '--allow-irreversible')
        self.assertEqual(r['summary']['all']['top1_step_accuracy'], 1.0)


if __name__ == '__main__':
    unittest.main()
