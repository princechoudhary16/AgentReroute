        self.assertEqual([c['verdict'] for c in checks],['SAT','VIOL'])
        boundary=compute_boundary(checks,.3)
        self.assertEqual(boundary['conclusive_checks'],2)
        self.assertEqual(boundary['divergence_rate'],.5)
