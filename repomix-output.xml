    def test_policy_and_system_messages_are_evidence(self):
        b = RunBuilder()
        b.steps.append({'index': 1, 'substeps': [{'sub_index': 1, 'role': 'system',
                                                   'content': 'Exchanges cost a $5.00 fee.'}]})
