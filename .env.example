# Export these in your shell. This package does not silently load .env files.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Azure option:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-10-21
# DeepSeek option uses a dedicated config and key:
DEEPSEEK_API_KEY=
# Gemini option (uses Google OpenAI-compatible endpoint):
GEMINI_API_KEY=
# Ollama option (local instance, no key required):
# OLLAMA_HOST_URL=http://127.0.0.1:11434
