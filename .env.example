# The demo UI reads GEMINI_API_KEY from the repository .env on refresh/new runs.
# A process environment variable takes precedence, including an explicit blank.
# CLI commands still require exported environment variables; they do not load .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Azure option:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-10-21
# DeepSeek option uses a dedicated config and key:
DEEPSEEK_API_KEY=
# Gemini UI default: gemini-3.1-flash-lite via Google's OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey and paste it locally below.
# Free-tier eligibility and quota depend on your Google project.
GEMINI_API_KEY=
# Optional UI request pacing (tokens per minute; default 200000):
# AGENTRX_DEMO_TPM_LIMIT=200000
# Ollama option (local instance, no key required):
# OLLAMA_HOST_URL=http://127.0.0.1:11434
