        "check_hint": "Compare the claimed available count against true available flags in the preceding product output.",
        "check_type": "python_check",
        "python_check": {
          "function_name": "available_count_matches",
          "args": [
            "trajectory",
            "current_step_index"
          ],
          "code_lines": [
            "import json",
            "import re",
            "def available_count_matches(trajectory, current_step_index):",
            "    steps = trajectory[\"steps\"]",
            "    current = steps[current_step_index][\"substeps\"][0][\"content\"]",
            "    claim = re.search(r\"There are (\\d+) available\", current)",
            "    if not claim:",
            "        return True",
            "    for step in reversed(steps[:current_step_index]):",
            "        for event in step[\"substeps\"]:",
            "            if event.get(\"name\") == \"get_product_details\":",
            "                data = json.loads(event[\"content\"])",
            "                actual = sum(v.get(\"available\") is True for v in data[\"variants\"].values())",
            "                return int(claim.group(1)) == actual",
            "    return True"
          ]
        }
      }
    ]
  },
